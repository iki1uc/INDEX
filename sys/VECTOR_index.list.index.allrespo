import { AUTO_LIST } from "./auto.list";
import { VECTOR_MEASURE } from "./vector.measure";

/* ============================================================
   RESPO – reine Vektor‑Basis
============================================================ */

export const VECTOR_RESPO = AUTO_LIST.map(v => ({
  id: v.id,
  state: v.state,
  color: v.color,
  vec: VECTOR_MEASURE(v.vec)
}));

/* ============================================================
   ALL – alle Vektor‑Stationen, aber RESPO ist Basis
============================================================ */

export const VECTOR_INDEX_ALLRESPO = {
  base: VECTOR_RESPO,   // reine Vektoren
  auto: VECTOR_RESPO,   // AUTO nutzt RESPO als Basis
  vec128: [],           // wird später gemessen
  run360: [],
  run128: [],
  run12: [],
  run9: [],
  matrix81: []
};
